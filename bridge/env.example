# Copiaza acest fisier ca ".env" in folderul bridge/ si completeaza.
# .env NU se pune niciodata in git (e deja in .gitignore).

# Adresa serverului Zof (fara / la final)
ZOF_SERVER_URL=https://api.exemplu.ro

# Ce locatie e fiecare fisier, dupa prefixul numelui: "ZOF-Centru-001.json" -> centru
# (asta e si valoarea implicita daca lasi linia goala)
ZOF_FILE_LOCATIONS=ZOF-Centru=centru,ZOF-Exercitiu=exercitiu

# Pentru FIECARE locatie: id-ul agentului si cheia API, exact cum le-a afisat
# comanda connector:add rulata PE SERVER (vezi README, pasul 1).
# Sufixul e numele locatiei cu MAJUSCULE ("-" devine "_": centru-2 -> CENTRU_2).
# Cheile se creeaza PE SERVERUL din ZOF_SERVER_URL, nu pe calculatorul tau (vezi README, pasul 1).
ZOF_CONNECTOR_ID_CENTRU=pc-centru-1
ZOF_API_KEY_CENTRU=
ZOF_CONNECTOR_ID_EXERCITIU=pc-exercitiu-1
ZOF_API_KEY_EXERCITIU=

# Fusul orar in care DorSoft scrie orele (implicit Europe/Bucharest)
# ZOF_TIMEZONE=Europe/Bucharest

# Cate randuri exporta DorSoft cel mult (implicit 1000). Un fisier cu exact atatea
# randuri e considerat plin si cel mai vechi document din el e sarit (vezi README, N3).
# Pune 0 daca exportul nu are limita.
# ZOF_EXPORT_ROW_CAP=1000
